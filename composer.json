{
    "name": "phpcollective/menumaker",
    "description": "An elegant multi level menu system for the Laravel framework.",
    "keywords": [
        "laravel menu system",
        "menu maker",
        "menu tree"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Al Amin Chayan",
            "email": "mail@chayan.me"
        }
    ],
    "require": {
        "php": "^8.3",
        "kalnoy/nestedset": "^7.0",
        "laravel/framework": ">=13.0",
        "spatie/laravel-html": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "classmap": [
            "src/Storage/seeds",
            "src/Storage/factories"
        ],
        "files": [
            "src/Http/helpers.php"
        ],
        "psr-4": {
            "PhpCollective\\MenuMaker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpCollective\\MenuMaker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhpCollective\\MenuMaker\\MenuServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
